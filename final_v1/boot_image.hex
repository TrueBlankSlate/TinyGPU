// $readmemh init for axi4_bram_slave.v -- same content as tb_cva6_boot.v's
// testbench preload, hand-placed at the same word indices its widx()
// masking maps BOOT_ADDR/MAT_ADDR/MUL_RESULT_ADDR/RESULT_ADDR to for
// MEM_WORDS=8192 (13-bit index, addr[15:3]):
//   BOOT_ADDR       = 0x8000_0000 -> index 0
//   MAT_ADDR        = 0x8000_1000 -> index 512  (0x200)
//   MUL_RESULT_ADDR = 0x8000_2000 -> index 1024 (0x400, left zero --
//                                     written at runtime by vse64.v, Option B)
//   RESULT_ADDR     = 0x8000_3000 -> index 1536 (0x600, left zero --
//                                     written at runtime by vse64.v)
//
// Boot program (Option B -- see tb_cva6_boot.v for the full derivation of
// each word; this MUST be kept byte-for-byte in sync with that file's
// instruction packing, since this is the only program real hardware runs --
// tb_cva6_boot.v's own `initial` block only feeds simulation):
//   lui x1,0x80001 / slli x1,x1,32 / srli x1,x1,32 / vle64.v / vmacc /
//   lui x1,0x80002 / slli x1,x1,32 / srli x1,x1,32 / vse64.v (writes C_mul) /
//   vadd.vv / lui x1,0x80003 / slli x1,x1,32 / srli x1,x1,32 /
//   vse64.v (writes C_add) / jal x0,0 / nop (pad)
